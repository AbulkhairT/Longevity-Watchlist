# Longevity Watchlist configuration. Copy to .env.local for local work.
# Never commit real values. Nothing here is exposed to browsers except NEXT_PUBLIC_*.

# Content source for the website build: "published" (default) or "fixtures".
# "fixtures" shows the illustrative design samples and is refused when
# VERCEL_ENV=production or LW_DEPLOY_ENV=production.
LW_CONTENT_MODE=published

# Absolute site URL used in RSS feeds and metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Research collection (Phase 3, GitHub Actions only) ----------------------
# NCBI E-utilities identify callers by tool and email. API key is optional.
NCBI_TOOL=longevity-watchlist
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# --- AI drafting (Phase 4, GitHub Actions only, after verification) ----------
ZAI_API_KEY=
